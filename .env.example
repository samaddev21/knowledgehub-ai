# KnowledgeHub AI — environment

# Demo mode (default). Set to false and provide OPENAI_API_KEY for live AI.
DEMO_MODE=true

# Optional — required when DEMO_MODE=false
# OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional production Postgres + pgvector
# DATABASE_URL=postgresql://user:pass@localhost:5432/knowledgehub

# Upload / retrieval tuning
MAX_UPLOAD_BYTES=10485760
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
